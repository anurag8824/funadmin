# Public site URL (used for canonical links and OG URLs)
NEXT_PUBLIC_SITE_URL=https://funtapp.com

# Backend API (matches funadmin-main backend baseURL)
FUNTAPP_API_BASE_URL=https://api.funtaap.com

# Backend secretKey — must match funadmin-main/backend/.env secretKey
# Server-only. Never prefix with NEXT_PUBLIC_.
FUNTAPP_API_SECRET_KEY=

# Android App Links — Play Console → App → App integrity → App signing key certificate → SHA-256
# Comma-separated if you have upload key + app signing key fingerprints.
# Example: AB:CD:EF:12:34:56:78:90:AB:CD:EF:12:34:56:78:90:AB:CD:EF:12:34:56:78:90:AB:CD:EF:12:34:56:78:90
ANDROID_SHA256_FINGERPRINTS=

# iOS Universal Links — Apple Developer → Membership → Team ID (10 chars)
IOS_TEAM_ID=

# Optional override (default from iosApp/Configuration/Config.xcconfig)
IOS_BUNDLE_ID=com.infayou.funtapp.FuntApp
